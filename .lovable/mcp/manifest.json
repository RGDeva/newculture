{
  "version": 1,
  "sdk_version": "3.0.4",
  "path": "/functions/v1/mcp",
  "auth": {
    "type": "none"
  },
  "mcp": {
    "server": {
      "name": "ascent-labs",
      "version": "0.1.0",
      "title": "Ascent Labs"
    },
    "tools": [
      {
        "name": "search_studios",
        "title": "Search recording studios",
        "description": "Search the NewCulture US recording studio directory by name, city, or state.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "description": "Text matched against studio name or city."
            },
            "state": {
              "type": "string",
              "minLength": 2,
              "maxLength": 2,
              "description": "Two-letter US state code, e.g. MA."
            },
            "minRating": {
              "type": "number",
              "minimum": 0,
              "maximum": 5,
              "description": "Minimum Google rating."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20,
              "description": "Max results."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_featured_artists",
        "title": "List featured artists",
        "description": "List the featured artists on the NewCulture roster.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": null,
        "outputSchema": null
      },
      {
        "name": "list_services",
        "title": "List services",
        "description": "List the services and tools NewCulture offers to artists and producers.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": null,
        "outputSchema": null
      }
    ]
  }
}
